# 이 파일을 복사해 이름을 .env 로 바꾸고, 오른쪽에 진짜 값을 채우세요.
# 진짜 값은 팀 단톡방 공지에서 받으세요. .env 는 깃허브에 올라가지 않습니다.

# ── Supabase (로그인·데이터베이스) ──
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=           # 서버 전용. 앱에 절대 넣지 않기
SUPABASE_JWKS_URL=             # 필요 시 사용. 현재 인증은 Auth 서버에 직접 확인

# ── 관리자 웹 (admin/) ──
ADMIN_EMAILS=                  # 관리자 학교 메일, 여러 명은 쉼표로 (예: a@skuniv.ac.kr,b@skuniv.ac.kr)

# ── 자체 AI (Ollama) ──
AI_FAKE=1                      # 1이면 Ollama 대신 가짜 AI(server/ai/fake.py). GPU PC에선 0
AI_BASE_URL=http://127.0.0.1:11434/v1   # localhost로 쓰면 Windows에서 호출마다 2초 늦어짐
CHAT_MODEL=kanana
EMBED_MODEL=                   # GPU PC: embeddinggemma-cpu (server/ai/embeddinggemma-cpu.Modelfile)
VISION_MODEL=                   # 사진 읽기(공지 포스터·성적증명서). 학교 서버: gemma3:4b, ollama pull 필요. 비우면 사진은 건너뜀
NOTICE_OCR_DIR=                 # 공지 사진 CPU OCR 환경 경로. 예: /home/namkh69/.local/previ-ocr. 비우면 VISION_MODEL 사용
DOC_MAX_DISTANCE=               # 문서 검색 거리 기준. embeddinggemma면 0.62 (10/29 실측: 관련 질문 ≤0.55, 무관 질문 ≥0.69). 비우면 거르지 않음

# ── 푸시 알림 ──
PUSH_ENABLED=false             # 실제 휴대폰 푸시는 토큰·설정 확인 후 true
EXPO_ACCESS_TOKEN=              # 서버 전용

# ── 앱이 부를 우리 서버 주소 ──
EXPO_PUBLIC_API_URL=http://localhost:8000
