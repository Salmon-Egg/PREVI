# 서버(server/)가 읽는 설정. 이 파일을 복사해 이름을 .env 로 바꾸고 값을 채우세요.
# 진짜 값은 팀 단톡방 공지에서 받으세요. .env 는 깃허브에 올라가지 않습니다.
# 앱(app/) 설정은 app/.env.example 에 따로 있습니다.

# ── 데이터베이스 ──
# Supabase › Project Settings › Database › Connection string (Session pooler 또는 Direct)
# 로컬 연습용 DB는 server/scripts/local_db.py 가 출력하는 주소
DATABASE_URL=

# ── Supabase (로그인 확인) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # 서버 전용. 계정 삭제에 씀. 앱에 절대 넣지 않기
ALLOWED_EMAIL_DOMAIN=           # 예: skuniv.ac.kr (비우면 검사 안 함)

# 1이면 "Bearer dev-<user_id>" 로 로그인 없이 접속 (시연용 가상 학생). 학교 서버 운영 때는 0
DEV_AUTH=1

# ── 자체 AI (Ollama) ──
AI_FAKE=1                       # 1이면 가짜 AI(규칙). Ollama가 준비되면 0
AI_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=kanana
EMBED_MODEL=
VISION_MODEL=gemma3:4b

# ── 푸시 알림 ──
PUSH_ENABLED=0                  # 1이면 실제로 휴대폰에 보냄. 0이면 알림 센터에만 기록
EXPO_ACCESS_TOKEN=              # 서버 전용 (Expo 계정에서 Enhanced Security를 켰을 때만 필요)

# ── 공지 수집 ──
BOARD_URL=                      # 학교 공개 게시판 목록 주소. 비우면 server/jobs/sample_board.json(예시 공지)
BOARD_LINK_PATTERN=             # 글 주소에서 글 번호를 뽑는 정규식. 비우면 기본값
BOARD_BODY_SELECTOR=            # 글 본문이 들어 있는 HTML 부분 (CSS 선택자)
