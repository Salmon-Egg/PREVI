# 이 파일을 복사해 이름을 .env 로 바꾸고, 오른쪽에 진짜 값을 채우세요.
# 진짜 값은 팀 단톡방 공지에서 받으세요. .env 는 깃허브에 올라가지 않습니다.

# ── Supabase (로그인·데이터베이스) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # 서버 전용. 앱에 절대 넣지 않기

# ── 자체 AI (Ollama) ──
AI_BASE_URL=http://localhost:11434/v1
CHAT_MODEL=kanana
EMBED_MODEL=
VISION_MODEL=gemma3:4b

# ── 푸시 알림 ──
EXPO_ACCESS_TOKEN=              # 서버 전용

# ── 앱이 부를 우리 서버 주소 ──
EXPO_PUBLIC_API_URL=http://localhost:8000
