{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "0",
        "EXPO_PUBLIC_DEV_LOGIN": "0",
        "EXPO_PUBLIC_EMAIL_DOMAIN": "skuniv.ac.kr"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_USE_MOCK": "0",
        "EXPO_PUBLIC_DEV_LOGIN": "0",
        "EXPO_PUBLIC_EMAIL_DOMAIN": "skuniv.ac.kr"
      }
    },
    "production": {}
  }
}
