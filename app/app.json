{
  "expo": {
    "name": "PREVI",
    "slug": "seokyeong-ai-secretary",
    "scheme": "seokyeongai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "kr.ac.skuniv.aisecretary",
      "adaptiveIcon": {
        "backgroundColor": "#5CC47B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "PREVI",
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-notifications",
      ["expo-image-picker", { "photosPermission": "습득물 사진을 올리려고 사진첩에 접근해요." }]
    ],
    "owner": "kaluso71s-team",
    "extra": {
      "eas": {
        "projectId": "c83b21d7-dd13-4280-9f46-c0ce068187a8"
      }
    }
  }
}
