{
  "expo": {
    "name": "서경 AI 비서",
    "slug": "seokyeong-ai-secretary",
    "scheme": "seokyeongai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "kr.ac.skuniv.aisecretary",
      "adaptiveIcon": {
        "backgroundColor": "#E9F3EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "습득물 사진을 찍어 제보하려면 카메라 권한이 필요해요.",
          "photosPermission": "습득물 사진을 앨범에서 고르려면 사진 권한이 필요해요."
        }
      ]
    ]
  }
}
