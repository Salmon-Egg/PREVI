# 앱 설정. 복사해서 app/.env 로 저장. EXPO_PUBLIC_ 값은 앱에 그대로 들어가므로 비밀 키(SUPABASE_SECRET_KEY)는 절대 넣지 않기.
# 실제 값(Supabase 주소·공개 키, 서버 주소)은 팀 단톡방 공지에서 받기. app/.env는 깃허브에 올라가지 않음.

# 우리 서버 주소. 휴대폰·APK에서는 localhost 대신 PC의 IP 또는 서버 공개 주소(Cloudflare Tunnel)
EXPO_PUBLIC_API_URL=http://localhost:8000

# 1이면 서버 없이 mocks/ 예시 데이터로 화면만 확인 (시연 사이트 npm run build:demo 는 자동으로 1)
EXPO_PUBLIC_USE_MOCK=0

# 1이면 Supabase 대신 앱이 가상 학생 4명(비밀번호 1234)만 확인 (서버 .env의 DEV_AUTH=1과 같이). 실제 서버 점검은 0
EXPO_PUBLIC_DEV_LOGIN=0

# 학번·비밀번호 로그인, 회원가입 (DEV_LOGIN=0일 때). ANON_KEY = 서버 .env의 SUPABASE_PUBLISHABLE_KEY와 같은 공개 키
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# 학번으로 로그인하면 '학번@이 도메인' 이메일로 확인 (시연 계정도 20210004@skuniv.ac.kr 꼴)
EXPO_PUBLIC_EMAIL_DOMAIN=skuniv.ac.kr
