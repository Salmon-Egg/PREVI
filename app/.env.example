# 앱 설정. 복사해서 app/.env 로 저장. EXPO_PUBLIC_ 값은 앱에 그대로 들어가므로 비밀 키는 넣지 않기.

# 우리 서버 주소. 휴대폰에서 테스트할 때는 localhost 대신 PC의 IP (예: http://192.168.0.10:8000)
EXPO_PUBLIC_API_URL=http://localhost:8000

# 1이면 서버 없이 mocks/ 예시 데이터로 화면만 확인
EXPO_PUBLIC_USE_MOCK=0

# 1이면 이메일 인증 대신 가상 학생 4명 중에서 골라 로그인 (서버 .env의 DEV_AUTH=1과 같이)
EXPO_PUBLIC_DEV_LOGIN=1

# 학교 이메일 로그인 (DEV_LOGIN=0일 때)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_EMAIL_DOMAIN=

# 1이면 분실물(캠퍼스 생활) 메뉴를 켜서 홈 메뉴가 4칸이 됨. 0이면 기본 3칸
EXPO_PUBLIC_LOST_ENABLED=0
